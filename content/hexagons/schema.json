{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kstoryworld.com/schemas/hexagon.json",
  "title": "Hexagon Manifest",
  "description": "Schema for a hexagon content cluster (1 k-drama anchor + 5 sister-domain articles). Source: JAC-1836 plan rev3.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hexagon_id", "season_window", "anchor", "sisters", "review", "publish"],
  "properties": {
    "hexagon_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable kebab-case identifier. Must match the filename stem."
    },
    "season_window": {
      "type": "string",
      "pattern": "^[0-9]{4}-(spring|summer|fall|winter)$",
      "description": "Default seasonal tone window for the cluster."
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "title_ko", "title_en", "year", "network", "hero_image"],
      "properties": {
        "domain": { "const": "k-drama" },
        "title_ko": { "type": "string", "minLength": 1 },
        "title_en": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2100 },
        "network": { "type": "string", "minLength": 1 },
        "hero_image": { "$ref": "#/definitions/hero_image" }
      }
    },
    "sisters": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "seed", "cross_links", "hero_image"],
        "properties": {
          "domain": {
            "enum": ["k-food", "k-pop", "k-beauty", "k-travel", "k-literature"]
          },
          "seed": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "cross_links": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z-]+/[a-z0-9-]+$" }
          },
          "hero_image": { "$ref": "#/definitions/hero_image" }
        }
      },
      "description": "Exactly 5 entries; each domain (k-food, k-pop, k-beauty, k-travel, k-literature) must appear exactly once. Cross-domain uniqueness is enforced by the validator, not the schema."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "policy"],
      "properties": {
        "status": {
          "enum": ["draft", "seeds_approved", "ready_for_board", "approved", "rejected"]
        },
        "policy": {
          "enum": ["bundle"],
          "description": "Gate-2 review policy. v1 only supports bundle (6편 묶음 검토)."
        },
        "board_approval_issue": {
          "type": ["string", "null"]
        }
      }
    },
    "publish": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy"],
      "properties": {
        "policy": {
          "enum": ["drip", "bundle-only"],
          "description": "Post-approval publish cadence. drip = 1~2 articles/day from queue (rev3 default, AdSense-safe). bundle-only = legacy rev2 behavior (all 6 publish together)."
        },
        "daily_cap": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2,
          "description": "Hard cap on daily publish count. Required when policy=drip; ignored when bundle-only."
        },
        "schedule_kind": {
          "enum": ["queue"],
          "description": "Queue scheduling discipline. v1 only supports FIFO-with-priority queue."
        },
        "recommended_order": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": ["k-drama", "k-food", "k-pop", "k-beauty", "k-travel", "k-literature"]
          },
          "description": "Publish order priority within the hexagon. Anchor (k-drama) typically first."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "policy": { "const": "drip" } } },
          "then": { "required": ["policy", "daily_cap", "schedule_kind", "recommended_order"] }
        }
      ]
    }
  },
  "definitions": {
    "hero_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "license", "seasonal_tone"],
      "properties": {
        "source": {
          "enum": ["unsplash", "pexels", "pixabay", "wikimedia", "cc0", "cc-by"]
        },
        "asset_id": { "type": "string" },
        "license": { "type": "string", "minLength": 1 },
        "credit": { "type": "string" },
        "seasonal_tone": {
          "enum": ["spring", "summer", "fall", "winter"]
        }
      }
    }
  }
}
